{
  "name": "routewarden-docs",
  "version": "0.2.4",
  "description": "Documentation and examples wiki site for RouteWarden Traefik middleware",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "docs:release": "node scripts/snapshot-version.mjs",
    "docs:dev": "node scripts/sync-version.mjs && vitepress dev docs",
    "docs:build": "node scripts/sync-version.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "node --test tests/*.test.mjs",
    "test:scripts": "node --test tests/*.test.mjs",
    "test:go": "go test -v -race ./...",
    "test:coverage": "go test -coverprofile=coverage.out ./... && go tool cover -func=coverage.out",
    "test:all": "npm run test:scripts && npm run test:go"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
